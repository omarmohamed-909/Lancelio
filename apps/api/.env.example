NODE_ENV=development
PORT=5000
WEB_ORIGIN=http://localhost:3000
MONGODB_URI=mongodb://127.0.0.1:27017/lancelio?replicaSet=rs0
JWT_ACCESS_SECRET=

# Password recovery: disabled until the verified Resend sender is configured.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=
# Vercel API only: set to external after deploying the separate recovery worker.
# Leave unset with EMAIL_PROVIDER=disabled or the local/persistent API server.
# RECOVERY_WORKER_MODE=external

# Assistant: guided help and scoped reads work without an external provider.
# To enable OpenAI question interpretation, set provider=openai and both values.
# Choose an available model supporting Responses API strict Structured Outputs.
ASSISTANT_PROVIDER=guided
OPENAI_API_KEY=
OPENAI_MODEL=

# Or use provider=gemini with a key and a model supporting structured output.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
