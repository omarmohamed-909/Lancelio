# Copy to .env.backup (ignored). This file is never loaded by the application.
# Each URI must include an explicit database name. No app URI fallback exists.
BACKUP_MONGODB_URI=
RESTORE_MONGODB_URI=
# Generate a separate random 32-byte hex key and keep it in your secret manager.
# Losing this key makes the encrypted backups unrecoverable.
BACKUP_ENCRYPTION_KEY=
# Absolute path to the official Database Tools bin directory.
MONGODB_TOOLS_DIRECTORY=
# Set to yes ONLY after stopping every API instance and recovery worker.
BACKUP_WRITES_PAUSED=no
